{
  "name": "@dsh-external/dsh-research-team",
  "version": "0.4.3",
  "description": "\u6df1\u5ea6\u7814\u7a76\u4e13\u5bb6\u56e2\uff1a\u4e3b\u7406\u4eba+6\u4e13\u5bb6 5\u9636\u6bb5\u7f16\u6392\uff08\u521d\u8c03\u2192\u5927\u7eb2\u2192\u9010\u7ae0\u5ba1\u7a3f\u4fee\u8ba2\u2192\u6846\u67b6\u2192\u53d1\u5e03\uff09\uff0c\u4ea7\u51fa\u591a\u6e90\u5f15\u7528\u7814\u7a76\u62a5\u544a\u3002\u79fb\u690d\u81ea WorkBuddy gpt-researcher-team \u4e13\u5bb6\u56e2\u534f\u8bae",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^18.3.31",
    "react": "^18.3.1",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build:client": "tsdown",
    "test": "node --test test/assess.test.js"
  },
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "deep-research",
    "research-report",
    "multi-agent",
    "agent-team"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fujunchao/dsh-research-team.git"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/dsh-client-ui-renderer": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-subagent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-tools": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0"
  }
}
